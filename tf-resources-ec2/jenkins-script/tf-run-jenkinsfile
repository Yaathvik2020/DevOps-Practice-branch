pipeline{
    agent any 
    parameters {
        choice(name: 'ENVIRONMENT', choices: ['dev', 'stage'], description: 'Target environment')
    }
    stages {
       stage('Cleanup') {
          steps{
              cleanWs()
            }
        }
       stage('checkout SCM') {
            steps{               
                git branch: 'main' ,url: 'https://github.com/Yaathvik2020/practice-branch.git'
                sh 'ls -ltr' 
               
             }
       }
      stage('Debug') {
            steps {
                sh 'echo "=== pwd ==="'
                sh 'pwd'
                sh 'echo "=== Top-level folders ==="'
                sh 'ls -la'
                sh 'echo "=== All directories (4 levels deep) ==="'
                sh 'find . -maxdepth 4 -type d'
                sh 'echo "=== All .tf files ==="'
                sh 'find . -name "*.tf"'
            }
       }
       stage('Run All Terraform Steps') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-creds'
                ]]) {
				dir('practice-branch/tf-resources-ec2') {
                    sh 'terraform init -input=false'
                    sh "terraform workspace select ${ENVIRONMENT} || terraform workspace new ${ENVIRONMENT}"
                    //sh "terraform plan -var-file=${ENVIRONMENT}.tfvars -out=tfplan -input=false"
		            sh 'terraform plan -out=tfplan -input=false'   // ✅ no -var-file needed
					//input message: "Apply this plan for ${ENVIRONMENT}?", ok: "Apply"
                    script {
                    timeout(time: 15, unit: 'MINUTES') {
                    input message: "Apply this plan for ${ENVIRONMENT}?", ok: "Apply"
                      }
					}
                    sh 'terraform apply -input=false tfplan' 
				}					
              }
          }
       }
	}     

post {
        success {
            echo 'Infra applied successfully.'
        }
        failure {
            echo 'Something went wrong.'
        }
    }
}
